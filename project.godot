; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ROXdandon"
config/description="PvE party game - 4 nhan vat co dinh vuot ai, khong PvP. Godot 4."
run/main_scene="res://core/app/MainShell.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

TroopDatabase="*res://core/database/TroopDatabase.gd"
StageDatabase="*res://core/database/StageDatabase.gd"
MapDatabase="*res://core/database/MapDatabase.gd"
BossDatabase="*res://core/database/BossDatabase.gd"
MaterialDatabase="*res://core/database/MaterialDatabase.gd"
EquipmentTypeDatabase="*res://core/database/EquipmentTypeDatabase.gd"
GameState="*res://core/app/GameState.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[dotnet]

project/assembly_name="ROXdandon"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
